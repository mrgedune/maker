// The maker's co-op room service. Deployed from this folder with
// `npx wrangler deploy`, only on David's word. Its address is the account's
// workers.dev one, which site/js/net/rooms.js and the site's CSP
// (site/_headers) name.
{
  "name": "maker-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // The pages a socket may come from, besides the Pages previews and this
    // machine (worker.js).
    "ORIGINS": "https://maker.rabbithouse.art https://rabbithouse-maker.pages.dev",
  },
}
